func TestApplyCodeFenceAndLineNumberStripping(t *testing.T) {
	dir := t.TempDir()
	filePath := filepath.Join(dir, "clean.go")
	orig := `package main

func greet() {
	println("hello")
}
`
	if err := os.WriteFile(filePath, []byte(orig), 0644); err != nil {
		t.Fatal(err)
	}

	patch := `<replace path="clean.go">
<search>
   3 | func greet() {
   4 | 	println("hello")
   5 | }
</search>
<with>
` + "```go" + `
func greet() {
	println("world")
}
` + "```" + `
</with>
</replace>`

	res, err := Apply(dir, patch, PatchOptions{})
	if err != nil {
		t.Fatalf("Apply with code fences/line numbers failed: %v", err)
	}
	if len(res.Changes) != 1 {
		t.Fatalf("Expected 1 change, got %d", len(res.Changes))
	}

	content, _ := os.ReadFile(filePath)
	cStr := string(content)
	if strings.Contains(cStr, "```") {
		t.Errorf("Code fence was not stripped:\n%s", cStr)
	}
	if !strings.Contains(cStr, `println("world")`) {
		t.Errorf("Updated code missing:\n%s", cStr)
	}
}

