func findLineWithAnchor(content, anchor string) int {
	clean := strings.TrimSpace(anchor)
	if clean == "" {
		return -1
	}
	offset := 0
	lines := strings.Split(content, "\n")
	for _, l := range lines {
		if strings.Contains(strings.TrimSpace(l), clean) {
			return offset
		}
		offset += len(l) + 1
	}
	return -1
}

func replaceSearchText(content, search, with string, fix bool) (string, error) {
	searchTrim := strings.TrimSpace(search)
	if searchTrim == "" {
		return content, nil
	}

	hasCRLF := strings.Contains(content, "\r\n")
	if hasCRLF {
		content = strings.ReplaceAll(content, "\r\n", "\n")
		search = strings.ReplaceAll(search, "\r\n", "\n")
		with = strings.ReplaceAll(with, "\r\n", "\n")
	}

	// Exact match
	if strings.Contains(content, search) {
		res := strings.Replace(content, search, with, 1)
		if hasCRLF {
			res = strings.ReplaceAll(res, "\n", "\r\n")
		}
		return res, nil
	}

	// Line-by-line whitespace-tolerant match (ignores trailing spaces)
	cLines := strings.Split(content, "\n")
	sLines := strings.Split(search, "\n")
	if len(sLines) <= len(cLines) {
		for i := 0; i <= len(cLines)-len(sLines); i++ {
			matched := true
			for j := 0; j < len(sLines); j++ {
				if strings.TrimRight(cLines[i+j], " \t\r") != strings.TrimRight(sLines[j], " \t\r") &&
					strings.TrimSpace(cLines[i+j]) != strings.TrimSpace(sLines[j]) {
					matched = false
					break
				}
			}
			if matched {
				var out []string
				out = append(out, cLines[:i]...)
				out = append(out, with)
				if i+len(sLines) < len(cLines) {
					out = append(out, cLines[i+len(sLines):]...)
				}
				res := strings.Join(out, "\n")
				if hasCRLF {
					res = strings.ReplaceAll(res, "\n", "\r\n")
				}
				return res, nil
			}
		}
	}

	// Wildcard / ellipsis (...) matching
	if strings.Contains(search, "...") {
		parts := strings.Split(search, "...")
		var reStr bytes.Buffer
		for i, part := range parts {
			trimmed := strings.TrimSpace(part)
			if trimmed == "" {
				continue
			}
			if i > 0 {
				reStr.WriteString(`(?s:(.*?))`)
			}
			reStr.WriteString(regexp.QuoteMeta(trimmed))
		}
		re, err := regexp.Compile(reStr.String())
		if err == nil && re.MatchString(content) {
			targetWith := with
			if strings.Contains(with, "...") {
				matches := re.FindStringSubmatch(content)
				if len(matches) > 1 {
					withParts := strings.Split(with, "...")
					var b bytes.Buffer
					for idx, wp := range withParts {
						b.WriteString(wp)
						if idx < len(matches)-1 {
