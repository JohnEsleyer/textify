func findDefinitionFallback(rootPath, symbolName string) string {
	clean := strings.TrimSpace(symbolName)
	clean = strings.Trim(clean, "()*&")
	if clean == "" {
		return ""
	}

	declRegex := regexp.MustCompile(`(?m)^\s*(?:func|fn|pub fn|def|class|type|interface|struct)\s+(?:(?:\([^)]*\)\s*)?` + regexp.QuoteMeta(clean) + `\b)`)

	var result strings.Builder
	_ = filepath.Walk(rootPath, func(path string, info os.FileInfo, err error) error {
		if err != nil || info.IsDir() {
			return nil
		}
		ext := strings.ToLower(filepath.Ext(path))
		switch ext {
		case ".go", ".ts", ".tsx", ".js", ".jsx", ".py", ".rs", ".java", ".c", ".cpp", ".h":
		default:
			return nil
		}

		data, readErr := os.ReadFile(path)
		if readErr != nil {
			return nil
		}

		rel, _ := filepath.Rel(rootPath, path)
		rel = filepath.ToSlash(rel)

		lines := strings.Split(string(data), "\n")
		for idx, l := range lines {
			if declRegex.MatchString(l) {
				st := idx + 1
				en := st + 30
				if en > len(lines) {
					en = len(lines)
				}
				result.WriteString(fmt.Sprintf("/* Definition: %s [%s:%d-%d] */\n", clean, rel, st, en))
				for j := st - 1; j < en; j++ {
					result.WriteString(fmt.Sprintf("%5d | %s\n", j+1, lines[j]))
				}
				result.WriteString("\n")
				return filepath.SkipAll
			}
		}
		return nil
	})

	return result.String()
}

