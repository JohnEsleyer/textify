func cleanBlockContent(s string) string {
	s = stripCodeFences(s)
	s = stripLineNumberPrefixes(s)

	if strings.HasPrefix(s, "\r\n") {
		s = s[2:]
	} else if strings.HasPrefix(s, "\n") {
		s = s[1:]
	}

	if strings.HasSuffix(s, "\r\n") {
		s = s[:len(s)-2]
	} else if strings.HasSuffix(s, "\n") {
		s = s[:len(s)-1]
	}

	idx := strings.LastIndex(s, "\n")
	if idx != -1 && strings.TrimSpace(s[idx+1:]) == "" {
		s = s[:idx]
	}

	return s
}

func stripCodeFences(s string) string {
	trimmed := strings.TrimSpace(s)
	if strings.HasPrefix(trimmed, "```") {
		lines := strings.Split(s, "\n")
		if len(lines) >= 2 && strings.HasPrefix(strings.TrimSpace(lines[0]), "```") {
			lastIdx := len(lines) - 1
			for lastIdx > 0 && strings.TrimSpace(lines[lastIdx]) == "" {
				lastIdx--
			}
			if lastIdx > 0 && strings.HasPrefix(strings.TrimSpace(lines[lastIdx]), "```") {
				return strings.Join(lines[1:lastIdx], "\n")
			}
		}
	}
	return s
}

func stripLineNumberPrefixes(s string) string {
	lines := strings.Split(s, "\n")
	hasPrefixes := true
	nonEmptyCount := 0
	prefixRe := regexp.MustCompile(`^\s*\d+\s*\|\s*`)
	for _, l := range lines {
		if strings.TrimSpace(l) == "" {
			continue
		}
		nonEmptyCount++
		if !prefixRe.MatchString(l) {
			hasPrefixes = false
			break
		}
	}
	if hasPrefixes && nonEmptyCount > 0 {
		for i, l := range lines {
			lines[i] = prefixRe.ReplaceAllString(l, "")
		}
		return strings.Join(lines, "\n")
	}
	return s
}
