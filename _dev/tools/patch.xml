						}
					}
					targetWith = b.String()
				}
			}
			res := re.ReplaceAllLiteralString(content, targetWith)
			if hasCRLF {
				res = strings.ReplaceAll(res, "\n", "\r\n")
			}
			return res, nil
		}
	}
